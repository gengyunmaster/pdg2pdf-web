# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Runtime data (uploads, jobs, results, wine prefixes)
data/
.wine/

# BYOB vendor area: deployer-provided Pdg2Pic.exe must never be committed.
vendor/*.exe
vendor/*.zip
!vendor/.gitkeep

# Local overrides of the bundled word list stay private.
*.local.txt
passwords.local.txt

# Misc
*.log
.DS_Store
